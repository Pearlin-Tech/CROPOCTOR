# ─── Firebase Client (VITE_ prefix = public in browser bundle) ─────────────────
# These keys are safe to commit as they are restricted by Firebase Security Rules.
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=1:your_sender_id:web:your_app_id

# ─── Google Maps (public) ────────────────────────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ─── FCM Web Push (public VAPID key) ────────────────────────────────────────
VITE_FCM_VAPID_KEY=your_fcm_vapid_key_here

# ─── Server-side only (NEVER use VITE_ prefix here) ──────────────────────────

# Gemini AI — get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-1.5-flash
GEMINI_VISION_MODEL=gemini-1.5-flash

# Google Earth Engine — path to service account JSON (local dev)
# On Vercel, use EE_SERVICE_ACCOUNT_JSON with the full JSON as a base64 string
EE_KEY_PATH=.gee-key.json
# EE_SERVICE_ACCOUNT_JSON=base64_encoded_service_account_json

# Cron job protection — generate: openssl rand -hex 32
CRON_SECRET=your_random_32_char_secret_here

# Firebase Admin SDK — for server-side push notifications
# Download from Firebase Console → Project Settings → Service Accounts → Generate new private key
# Then: base64 -i serviceAccountKey.json | tr -d '\n'
# FIREBASE_ADMIN_KEY_BASE64=base64_encoded_admin_sdk_json

# Optional: Google Weather API (falls back to Open-Meteo if not set)
# GOOGLE_WEATHER_API_KEY=your_google_weather_key_here

# Server port (local dev only)
PORT=3001

# ─── Vercel Deployment (Add these in Vercel Project Settings) ───────────────
# When deploying to Vercel, you DO NOT need to add the VITE_ prefix.
# Copy these values directly into the Vercel dashboard:
# - GEMINI_API_KEY
# - GEMINI_TEXT_MODEL
# - GEMINI_VISION_MODEL
# - CRON_SECRET
# - FIREBASE_ADMIN_KEY_BASE64
# - EE_SERVICE_ACCOUNT_JSON
